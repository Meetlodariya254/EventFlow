rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users: each user owns their own profile doc ──────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Events ────────────────────────────────────────────────────
    match /events/{eventId} {
      // Read: only the owner
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      // Create: authenticated user must set themselves as owner
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0;

      // Update: owner only, cannot change userId
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId;

      // Delete: owner only
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // ── Reminders ─────────────────────────────────────────────────
    match /reminders/{reminderId} {
      // Read: only the owner can see their reminders
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;

      // Writes are done exclusively by Cloud Functions via Admin SDK
      // (Admin SDK bypasses all security rules)
      allow write: if false;
    }
  }
}
